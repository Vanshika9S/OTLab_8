+// Simple pseudo-random generator for lottery ticket selection
+static unsigned long rand_seed = 123456789;
+static int
+pseudo_rand(int max)
+{
+  if (max <= 0)
+    return 0;
+  rand_seed = rand_seed * 1103515245 + 12345;
+  return (int)((rand_seed / 65536) % max);
+}
+
+// Per-CPU process scheduler: Lottery Scheduling implementation.
+// Replaces default round-robin with proportional share lottery.
 void
 scheduler(void)
 {
   struct proc *p;
   struct cpu *c = mycpu();
   c->proc = 0;
+
   for(;;){
     // Avoid deadlock by ensuring that devices can interrupt.
     intr_on();
 
+    int total_tickets = 0;
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->state == RUNNABLE) {
+        total_tickets += p->tickets;
+      }
+      release(&p->lock);
+    }
+
+    if(total_tickets == 0)
+      continue;
+
+    int winning_ticket = pseudo_rand(total_tickets);
+    int current_counter = 0;
+
     for(p = proc; p < &proc[NPROC]; p++) {
       acquire(&p->lock);
       if(p->state == RUNNABLE) {
+        current_counter += p->tickets;
+        if(current_counter > winning_ticket) {
+          // Switch to chosen process.
+          p->state = RUNNING;
+          p->ticks++;
+          c->proc = p;
+          swtch(&c->context, &p->context);
+
+          // Process is done running for now.
+          c->proc = 0;
+          release(&p->lock);
+          break;
+        }
+      }
+      release(&p->lock);
     }
   }
 }
+
+// System call implementations
+int
+settickets(int number)
+{
+  if (number < 1)
+    return -1;
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets = number;
+  release(&p->lock);
+  return 0;
+}
+
+int
+getpstat(uint64 addr)
+{
+  struct proc *cur = myproc();
+  struct pstat ps;
+  struct proc *p;
+  int i = 0;
+
+  for(p = proc; p < &proc[NPROC]; p++, i++){
+    acquire(&p->lock);
+    ps.inuse[i] = (p->state != UNUSED);
+    ps.pid[i] = p->pid;
+    ps.tickets[i] = p->tickets;
+    ps.ticks[i] = p->ticks;
+    ps.state[i] = (int)p->state;
+    release(&p->lock);
+  }
+
+  if(copyout(cur->pagetable, addr, (char *)&ps, sizeof(ps)) < 0)
+    return -1;
+  return 0;
+}
